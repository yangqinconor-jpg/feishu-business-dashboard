MYSQL_CLIENT=mysql
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

DELETE_TOTAL_CHANNEL=true
DELETE_UNTYPED_RECORDS=true
VIDEO_TALENT_WINDOWS=

# 设置后每次从该日期查到今天；留空则使用 LOOKBACK_DAYS。
SYNC_START_DATE=
LOOKBACK_DAYS=10
MYSQL_QUERY_TIMEOUT_SECONDS=900
FEISHU_HTTP_TIMEOUT_SECONDS=60
FEISHU_HTTP_RETRIES=3
