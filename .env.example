FEISHU_APP_TOKEN=your_bitable_app_token
FEISHU_TABLE_ID=your_bitable_table_id
FEISHU_ORDER_DETAIL_TABLE_ID=your_order_detail_table_id
FEISHU_APP_USER_DATA_TABLE_ID=your_app_user_data_table_id
FEISHU_PRODUCT_MAPPING_TABLE_ID=your_product_mapping_table_id

FEISHU_FIELD_DATE=日期
FEISHU_FIELD_CHANNEL=成交平台
FEISHU_FIELD_AMOUNT=金额
FEISHU_FIELD_SYNC_TIME=同步时间
FEISHU_FIELD_ORDER_COUNT=订单数
FEISHU_FIELD_SALE_TYPE=渠道
FEISHU_FIELD_REFUND_COUNT=退款订单数
FEISHU_FIELD_NET_AMOUNT=退款后金额
